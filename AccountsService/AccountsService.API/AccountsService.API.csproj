<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c8ce2cf3-b745-4c5e-876d-3559b1fceb26</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <!-- Design-time package for dotnet-ef (migration generation/application via the startup project). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="..\.dockerignore" />
  </ItemGroup>

  <ItemGroup>
    <!-- RS256 key pair for signing/validating JWTs. Copied to the output so the relative path
         from JwtSettings:PrivateKeyPath/PublicKeyPath works the same under `dotnet run` and from a published build. -->
    <Content Include="Keys\**\*.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccountsService.Domain\AccountsService.Domain.csproj" />
    <ProjectReference Include="..\AccountsService.Application\AccountsService.Application.csproj" />
    <ProjectReference Include="..\AccountsService.Infrastructure\AccountsService.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared.Kernel.AspNetCore\Shared.Kernel.AspNetCore.csproj" />
  </ItemGroup>

</Project>
