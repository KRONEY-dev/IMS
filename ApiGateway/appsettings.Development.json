{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "JwtValidationSettings": {
    "Issuer": "IMS.AccountsService",
    "Audience": "IMS",
    "PublicKeyPath": "Keys/accounts-public.pem"
  },
  "DocsAccessSettings": {
    "AllowedNetworks": [ "127.0.0.1/32", "::1/128" ]
  },
  "RateLimitingSettings": {
    "Limit": 5,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "Routes": {
      "accounts-login-route": {
        "ClusterId": "accounts-cluster",
        "Order": -10,
        "Match": {
          "Path": "/accounts/api/Auth/Login"
        },
        "Metadata": { "RateLimited": "true" },
        "Transforms": [
          { "PathRemovePrefix": "/accounts" }
        ]
      },
      "accounts-refresh-route": {
        "ClusterId": "accounts-cluster",
        "Order": -10,
        "Match": {
          "Path": "/accounts/api/Auth/Refresh"
        },
        "Metadata": { "RateLimited": "true" },
        "Transforms": [
          { "PathRemovePrefix": "/accounts" }
        ]
      },
      "accounts-openapi-route": {
        "ClusterId": "accounts-cluster",
        "AuthorizationPolicy": "DocsAllowlist",
        "Order": -10,
        "Match": {
          "Path": "/accounts/openapi/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/accounts" }
        ]
      },
      "accounts-scalar-route": {
        "ClusterId": "accounts-cluster",
        "AuthorizationPolicy": "DocsAllowlist",
        "Order": -10,
        "Match": {
          "Path": "/accounts/scalar/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/accounts" }
        ]
      },
      "accounts-route": {
        "ClusterId": "accounts-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/accounts/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/accounts" }
        ]
      },
      "inventory-openapi-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "DocsAllowlist",
        "Order": -10,
        "Match": {
          "Path": "/inventory/openapi/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/inventory" }
        ]
      },
      "inventory-scalar-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "DocsAllowlist",
        "Order": -10,
        "Match": {
          "Path": "/inventory/scalar/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/inventory" }
        ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/inventory" }
        ]
      }
    },
    "Clusters": {
      "accounts-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5095"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5094"
          }
        }
      }
    }
  }
}