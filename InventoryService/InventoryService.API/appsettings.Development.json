{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Inventory": "Host=localhost;Port=5433;Database=inventory;Username=postgres;Password=postgres"
  },
  "StockConcurrencySettings": {
    "MaxRetryAttempts": 3
  },
  "RabbitMqSettings": {
    "HostName": "localhost",
    "BatchSize": 20,
    "PollingIntervalSeconds": 3,
    "Queues": {
      "InventoryEvents": "stock-quantity-changed"
    }
  }
}