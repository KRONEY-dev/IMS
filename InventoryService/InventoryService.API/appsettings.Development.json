{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Inventory": "Host=localhost;Port=5433;Database=inventory;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "StockConcurrencySettings": {
    "MaxRetryAttempts": 3
  },
  "RabbitMqSettings": {
    "HostName": "localhost",
    "BatchSize": 20,
    "PollingIntervalSeconds": 3,
    "Queues": {
      "InventoryEvents": "stock-quantity-changed"
    }
  },
  "SupplierOrderReminderJobSettings": {
    "CronExpression": "0 0 8 * * ?",
    "LookaheadDays": 3,
    "LockTtlSeconds": 300
  }
}